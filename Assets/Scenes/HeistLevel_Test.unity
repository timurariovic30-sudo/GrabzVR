  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. \u0416\u043C\u0438 <b>\u0421\u0422\u0410\u0420\u0422</b> \u043D\u0430 \u043F\u0443\u043B\u044C\u0442\u0435 \u2014 \u0448\u043B\u044E\u0437 \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F, \u043F\u043E\u0439\u0434\u0451\u0442 \u0442\u0430\u0439\u043C\u0435\u0440 3:00\n2. \u0423\u043A\u0440\u0430\u0434\u0438 \u043B\u0443\u0442 \u0438 \u0434\u043E\u043D\u0435\u0441\u0438 \u0434\u043E <b>\u0444\u0443\u0440\u0433\u043E\u043D\u0430</b> \u0432 \u043F\u043E\u0434\u0437\u0435\u043C\u043D\u043E\u043C \u0433\u0430\u0440\u0430\u0436\u0435\n3. \u0426\u0435\u043B\u044C \u2014 <b>$4000</b>. \u0421\u0435\u0439\u0444 \u0442\u044F\u0436\u0451\u043B\u044B\u0439: \u221240% \u043A \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438\n4. \u041B\u0430\u0437\u0435\u0440\u044B, \u043A\u0430\u043C\u0435\u0440\u044B \u0438 \u0440\u0430\u0437\u0431\u0438\u0442\u043E\u0435 \u0441\u0442\u0435\u043A\u043B\u043E = <b>\u0422\u0420\u0415\u0412\u041E\u0413\u0410</b> (\u221215 \u0441\u0435\u043A)\n5. \u0412\u0430\u0437\u0430 \u0445\u0440\u0443\u043F\u043A\u0430\u044F \u2014 \u043D\u0435 \u0448\u0432\u044B\u0440\u044F\u0439 \u0435\u0451!\n6. \u0421\u0435\u043A\u0440\u0435\u0442: \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u044F \u0438\u0437 \u043E\u0444\u0438\u0441\u043E\u0432 \u0432\u0435\u0434\u0451\u0442 \u043F\u0440\u044F\u043C\u043E \u0432 \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435"
